# ---------------------------------------------------------------------------
# RIFQ Muslim - environment template
# Copy to .env for local use. On AppJet, add these in Settings -> Environment
# variables (never commit real secrets).
# ---------------------------------------------------------------------------

# Shared backend
PORT=3000
NODE_ENV=production

# Signs login tokens. REQUIRED in production: without it sessions end on restart.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: bootstrap/administrator account, created on first start.
# The admin account unlocks the protected Admin section of the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the JSON database is written. Point at a mounted volume for durability.
DATA_DIR=

# Optional reverse-geocoding overrides. The app works without any key by using
# BigDataCloud + OpenStreetMap Nominatim. Add a key to raise rate limits or use
# a commercial provider.
GEOCODE_PROVIDER=            # bigdatacloud | nominatim | google | mapbox
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Optional transactional email for password-reset delivery. Without it the
# backend returns the reset code to the caller and clearly labels it as
# "delivery: not_configured" (development/testing only).
RESEND_API_KEY=
RESET_FROM_EMAIL=

# Client build (mobile/.env) - the API base URL baked into the app.
# EXPO_PUBLIC_API_URL=https://your-app-url
